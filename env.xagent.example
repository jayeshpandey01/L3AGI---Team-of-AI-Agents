# L3AGI XAgent Environment Configuration
# Copy this file to .env.xagent and update with your actual values

# XAgent Configuration
CONFIG_FILE=./configs/xagent/config.yml
XAGENT_ENABLED=true
XAGENT_CONFIG_PATH=./configs/xagent/config.yml

# ToolServer Configuration
TOOLSERVER_URL=http://localhost:8080
TOOLSERVER_API_KEY=your_toolserver_key_here

# Database Configuration for XAgent
DB_USERNAME=xagent
DB_PASSWORD=xagent
DB_COLLECTION=toolserver
MYSQL_ROOT_PASSWORD=xagent
REDIS_PASSWORD=xagent

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_ORGANIZATION=your_organization_id_here

# RapidAPI Configuration
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=rapidapi.com

# L3AGI Integration
L3AGI_API_KEY=your_l3agi_api_key_here
L3AGI_SERVER_URL=http://localhost:8000

# Zep Memory Configuration
ZEP_API_URL=http://localhost:8000
ZEP_API_KEY=your_zep_api_key_here

# Database URLs (if using external databases)
POSTGRES_URL=postgresql://user:pass@localhost:5432/l3agi
MYSQL_URL=mysql://user:pass@localhost:3306/l3agi

# API Keys for Communication Tools
TWILIO_API_KEY=your_twilio_key_here
SENDGRID_API_KEY=your_sendgrid_key_here
SLACK_API_KEY=your_slack_key_here
TWITTER_API_KEY=your_twitter_key_here
INSTAGRAM_API_KEY=your_instagram_key_here
GMAIL_API_KEY=your_gmail_key_here

# Google Services
GOOGLE_CALENDAR_API_KEY=your_google_calendar_key_here
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/google-credentials.json

# Zapier Configuration
ZAPIER_API_KEY=your_zapier_key_here

# Weather and External Services
OPENWEATHER_API_KEY=your_openweather_key_here
YOUTUBE_API_KEY=your_youtube_key_here

# Cal.com Configuration
CAL_API_KEY=your_cal_api_key_here

# Security and Access Control
L3AGI_WORKSPACE_PATH=./local_workspace
L3AGI_TOOL_TIMEOUT=300
L3AGI_MAX_FILE_SIZE=10MB

# Logging and Monitoring
LOG_LEVEL=INFO
LOG_FILE=./logs/xagent.log
RECORD_DIR=./logs/xagent

# Feature Flags
USE_XAGENT=true
XAGENT_TOOLS_ONLY=false
HYBRID_MODE=true
FALLBACK_TO_REACT=true

# Network Configuration
XAGENT_NETWORK_SUBNET=172.20.0.0/16
TOOLSERVER_NETWORK=172.21.0.0/16
